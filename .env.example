# Optional backend/localnet only. npm ci; npm run demo needs no .env file.
# These credentials are intentionally public local development placeholders.
DATABASE_URL=postgresql://dustpact:dustpact_dev_only@127.0.0.1:15439/dustpact_v2
DUSTPACT_V2_DATABASE_URL=postgresql://dustpact:dustpact_dev_only@127.0.0.1:15439/dustpact_v2
DUSTPACT_V3_DATABASE_URL=postgresql://dustpact:dustpact_dev_only@127.0.0.1:15439/dustpact_v3
DUSTPACT_V2_TEST_DATABASE_URL=postgresql://dustpact:dustpact_dev_only@127.0.0.1:15439/dustpact_v2_test
DUSTPACT_V3_TEST_DATABASE_URL=postgresql://dustpact:dustpact_dev_only@127.0.0.1:15439/dustpact_v3_test
DUSTPACT_V2_RPC=http://127.0.0.1:19809
DUSTPACT_V3_RPC=http://127.0.0.1:19809
DUSTPACT_V2_PORT=4194
DUSTPACT_V2_FEE_PORT=4196
DUSTPACT_V3_PORT=4197
DUSTPACT_V3_FEE_PORT=4198
DUSTPACT_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174
# Local generated service signing and optional sponsorship stay off by default.
DUSTPACT_V2_ALLOW_LOCAL_SIGNING=0
DUSTPACT_V3_ALLOW_LOCAL_SIGNING=0
DUSTPACT_V2_FEE_SPONSOR=0
DUSTPACT_V3_FEE_SPONSOR=0
# If using another browser port, update DUSTPACT_ORIGINS accordingly.
# Public/devnet wallets remain disabled without separately reviewed release policies.
